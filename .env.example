# Anthropic Claude API Key for Deep LLM ATS Resume Analysis
# Get your API key from https://console.anthropic.com/
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# SQLite Database connection URL
DATABASE_URL=sqlite:///./sql_app.db

# Secret key for JWT session / auth tokens
SECRET_KEY=placify-ai-secret-key-change-in-production

# Frontend / API Server port
PORT=8080

# Optional backend URL if running companion Python FastAPI backend
VITE_API_BASE_URL=http://localhost:8000/api/v1
